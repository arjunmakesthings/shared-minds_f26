# copy this file to .env (which is gitignored) and fill it in.

# supabase dashboard → project settings → data api
SUPABASE_URL=https://your-project-ref.supabase.co

# supabase dashboard → project settings → api keys → "secret" key (sb_secret_...)
# or the legacy "service_role" key. never put this in the browser or commit it.
SUPABASE_SECRET_KEY=

# optional
TURN_SECONDS=60
# a name for this machine, shown in logs and used so two running workers don't collide
WORKER_ID=
